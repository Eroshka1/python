students: set[str] = {"Tom", "Bob", "Sam"}
employees: set[str] = {"Tom", "Bob", "Alex", "Mike"}

print(f"Все люди: {students | employees}")
print(f"Люди, которые учатся и работают: {students.intersection(employees)}")
print(f"Люди, которые учатся, но не работают: { students - employees}")
print(f"Люди, которые либо учатся, либо работают: {students ^ employees}")

