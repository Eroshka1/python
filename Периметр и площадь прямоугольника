class Rectangle:
    def __init__(self, width, length):
        self.width = width
        self.length = length


    def area(self):
        return self.width * self.length

    def perimeter(self):
        return 2*(self.width + self.length)

rect1 = Rectangle(10, 20)
rect2 = Rectangle(5, 7)

print(rect1.area())
print(rect2.perimeter())

